    "access": "public"
  },
  "scripts": {
    "test": "bun test src/dock.test.ts src/auth.test.ts && vitest run"
  },
  "peerDependencies": {
    "svelte": "^5"
  },
  "sideEffects": false,
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6",
    "@testing-library/svelte": "^5",
    "jsdom": "^26",
    "vitest": "^3"
  }
