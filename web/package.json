      "import": "./src/auth.ts"
    },
    "./dock": {
      "types": "./src/dock.ts",
      "import": "./src/dock.ts"
    },
    "./components/AccountConnection.svelte": "./src/components/AccountConnection.svelte",
    "./components/ChatDock.svelte": "./src/components/ChatDock.svelte",
    "./components/Dock.svelte": "./src/components/Dock.svelte",
