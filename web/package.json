  },
  "files": ["index.js", "index.d.ts", "src/", "wasm/", "source/", "LICENSE", "LICENSE.md", "LICENSES/", "README.md", "THIRD-PARTY.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbet-foss/ccht.git"
  },
